-add_library(${LOVE_LIB_NAME} SHARED ${LOVE_LIB_SRC} ${LOVE_RC})
+if(EMSCRIPTEN)
+	# Chrogue: the page has one module. A shared library is a side module in CMake 4.3.3 and later.
+	add_library(${LOVE_LIB_NAME} STATIC ${LOVE_LIB_SRC} ${LOVE_RC})
+else()
+	add_library(${LOVE_LIB_NAME} SHARED ${LOVE_LIB_SRC} ${LOVE_RC})
+endif()
 set_target_properties(${LOVE_LIB_NAME} PROPERTIES C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
 target_link_libraries(${LOVE_LIB_NAME} ${LOVE_LINK_LIBRARIES} ${LOVE_3P})
 
+# Chrogue: the core of the game as the Lua module chrogue_core (ports/web in the Chrogue repository).
+if(EMSCRIPTEN AND CHROGUE_CORE_LIB)
+	add_library(chrogue_core_lua STATIC ${CHROGUE_CORE_LUA})
+	target_include_directories(chrogue_core_lua PRIVATE ${CHROGUE_CORE_INCLUDE})
+	target_link_libraries(chrogue_core_lua ${LOVE_LUA_LIBRARY} ${CHROGUE_CORE_LIB})
+	target_link_libraries(${LOVE_LIB_NAME} chrogue_core_lua)
+	target_compile_definitions(${LOVE_LIB_NAME} PRIVATE CHROGUE_CORE)
+endif()
+
 if(LOVE_EXTRA_DEPENDECIES)
 	add_dependencies(${LOVE_LIB_NAME} ${LOVE_EXTRA_DEPENDECIES})
 endif()
