{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": ".rules-src",
    "outDir": "generated"
  },
  "tstl": {
    "luaTarget": "JIT",
    "luaLibImport": "require",
    "noHeader": false,
    "sourceMapTraceback": false,
    "noImplicitSelf": true,
    "luaPlugins": [
      {
        "name": "./tools/tstl-plugin.cjs"
      }
    ]
  },
  "include": [
    ".rules-src/**/*.ts"
  ]
}